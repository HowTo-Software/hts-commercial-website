@inject IStringLocalizer<AppStrings> L

<section id="services" class="section services-section">
    <div class="container services-layout">
        <div class="services-intro"><p class="eyebrow"><span class="section-number">02</span>@L["ServicesEyebrow"]</p><h2><MaskReveal>@L["ServicesTitle"]</MaskReveal><MaskReveal Delay="70"><span class="orange-text">@L["ServicesTitleSecond"]</span></MaskReveal></h2><p data-reveal>@L["ServicesIntro"]</p><div class="services-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><span class="art-star"><UiIcon Name="star" /></span><span class="art-code">&lt;hts /&gt;</span><span class="art-caption">@L["ArtCaption"]</span></div></div>
        <div class="services-list">
            <ServiceCard Index="01" Service="website" Title="@L["ServiceWebDev"]" Description="@L["ServiceWebDevDesc"]" LinkText="@L["ChooseService"]" InitiallyOpen="true" />
            <ServiceCard Index="02" Service="business" Title="@L["ServiceBusinessSites"]" Description="@L["ServiceBusinessSitesDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="03" Service="landing" Title="@L["ServiceLanding"]" Description="@L["ServiceLandingDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="04" Service="custom" Title="@L["ServiceCustom"]" Description="@L["ServiceCustomDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="05" Service="maintenance" Title="@L["ServiceMaintenance"]" Description="@L["ServiceMaintenanceDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="06" Service="backend" Title="@L["ServiceBackend"]" Description="@L["ServiceBackendDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="07" Service="hosting" Title="@L["ServiceHosting"]" Description="@L["ServiceHostingDesc"]" LinkText="@L["ChooseService"]" />
            <ServiceCard Index="08" Service="consulting" Title="@L["ServiceConsulting"]" Description="@L["ServiceConsultingDesc"]" LinkText="@L["ChooseService"]" />
        </div>
    </div>
    <div class="container services-footnote"><UiIcon Name="check" /><span>@L["ServicesFootnote"]</span><span>@L["BuiltWithPurpose"]</span></div>
</section>
