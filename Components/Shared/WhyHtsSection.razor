@inject IStringLocalizer<AppStrings> L

<section id="about" class="section process-section">
    <div class="container">
        <div class="section-heading split-heading"><div><p class="eyebrow"><span class="section-number">03</span>@L["ProcessEyebrow"]</p><h2><MaskReveal>@L["ProcessTitle"]</MaskReveal><MaskReveal Delay="70"><span class="muted-heading">@L["ProcessTitleSecond"]</span></MaskReveal></h2></div><p class="heading-aside" data-reveal>@L["ProcessIntro"]</p></div>
        <div class="process-grid">
            @for (var i = 1; i <= 4; i++)
            {
                <article class="process-step" data-reveal style="--reveal-delay: @((i - 1) * 70)ms"><div class="step-top"><span>@i.ToString("00")</span><UiIcon Name="@(i == 4 ? "check" : "diagonal")" /></div><h3>@L[$"ProcessStep{i}"]</h3><p>@L[$"ProcessStep{i}Desc"]</p></article>
            }
        </div>
        <div class="manifesto" data-reveal><span class="manifesto-symbol"><UiIcon Name="star" /></span><p>@L["ManifestoStart"] <strong>@L["ManifestoStrong"]</strong></p><span class="manifesto-signature">HTS /<br />HOWTO.SOFTWARE</span></div>
        <div class="faq-layout"><div><p class="eyebrow">@L["FaqEyebrow"]</p><h3>@L["FaqTitle"]</h3></div><div class="faq-list">
            @for (var i = 1; i <= 6; i++)
            {
                <details class="faq-item" name="hts-faq"><summary>@L[$"FaqQuestion{i}"]<UiIcon Name="plus" /></summary><p>@L[$"FaqAnswer{i}"]</p></details>
            }
        </div></div>
    </div>
</section>
