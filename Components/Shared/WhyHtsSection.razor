@inject IStringLocalizer<AppStrings> L

<section id="about" class="section why-section">
    <div class="why-backdrop"></div>
    <div class="container why-content">
        <div class="section-heading compact-heading">
            <p class="eyebrow"><span></span>@L["WhyEyebrow"]</p>
            <h2>@L["WhyTitle"]</h2>
        </div>

        <div class="why-grid">
            <article><div class="why-icon">ϟ</div><h3>@L["WhyAgility"]</h3><p>@L["WhyAgilityDesc"]</p></article>
            <article><div class="why-icon">◎</div><h3>@L["WhyPersonalized"]</h3><p>@L["WhyPersonalizedDesc"]</p></article>
            <article><div class="why-icon">◇</div><h3>@L["WhyModern"]</h3><p>@L["WhyModernDesc"]</p></article>
            <article><div class="why-icon">✓</div><h3>@L["WhyClean"]</h3><p>@L["WhyCleanDesc"]</p></article>
            <article><div class="why-icon">◌</div><h3>@L["WhyReliable"]</h3><p>@L["WhyReliableDesc"]</p></article>
        </div>

        <blockquote>@L["WhyQuote"]</blockquote>
    </div>
</section>
