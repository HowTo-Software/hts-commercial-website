@inject IStringLocalizer<AppStrings> L

<section id="projects" class="section projects-section">
    <div class="container">
        <div class="section-heading split-heading">
            <div><p class="eyebrow"><span class="section-number">01</span>@L["ProjectsEyebrow"]</p><h2><MaskReveal>@L["ProjectsTitle"]</MaskReveal><MaskReveal Delay="70"><span class="muted-heading">@L["ProjectsTitleSecond"]</span></MaskReveal></h2></div>
            <p class="heading-aside" data-reveal>@L["ProjectsIntro"]</p>
        </div>
        <div class="project-filters" data-reveal role="group" aria-label="@L["FilterProjects"]">
            @foreach (var filter in Filters)
            {
                <button type="button" class="@(_filter == filter.Value ? "is-active" : "")" aria-pressed="@(_filter == filter.Value ? "true" : "false")" @onclick="() => _filter = filter.Value">@L[filter.Label]<span>@Projects.Count(p => filter.Value == "all" || p.Category == filter.Value)</span></button>
            }
            <span class="filter-caption">@L["SelectedConcepts"] / 2026</span>
        </div>
        <div class="projects-grid" aria-live="polite" aria-atomic="false">
            @foreach (var project in Projects.Where(p => _filter == "all" || p.Category == _filter))
            {
                <ProjectCard @key="(project.Index, _filter)" RevealDelay="@((int.Parse(project.Index, CultureInfo.InvariantCulture) - 1) % 2 * 90)" Image="@project.Image" ImageAlt="@L[project.Alt]" Title="@project.Title" Subtitle="@L[project.Subtitle]" Description="@L[project.Description]" Theme="@project.Theme" Index="@project.Index" Domain="@project.Domain" DisplayBrand="@project.Brand" Headline="@L[project.Headline]" Service="@project.Service" />
            }
        </div>
        <div class="projects-bottom" data-reveal><span>@L["ProjectsBottom"]</span><a class="animated-link" href="#quote">@L["CreateYours"] <UiIcon Name="diagonal" /></a></div>
    </div>
</section>
@code {
    private string _filter = "all";
    private static readonly (string Value, string Label)[] Filters = [("all", "FilterAll"), ("business", "FilterBusiness"), ("landing", "FilterLanding"), ("booking", "FilterBooking")];
    private sealed record Project(string Index, string Title, string Brand, string Domain, string Image, string Alt, string Subtitle, string Description, string Headline, string Theme, string Category, string Service);
    private static readonly Project[] Projects = [
        new("01", "Almeida Construction", "almeida®", "almeida.studio", "images/project-construction.png", "ProjectAlmeidaAlt", "ProjectCorporate", "ProjectAlmeidaDescription", "ProjectAlmeidaHeadline", "theme-sand", "business", "business"),
        new("02", "Performance Workshop", "PERFORMANCE/", "performance.auto", "images/project-workshop.png", "ProjectWorkshopAlt", "ProjectBooking", "ProjectWorkshopDescription", "ProjectWorkshopHeadline", "theme-lilac", "booking", "custom"),
        new("03", "Shield Security", "SHIELD®", "shield.security", "images/project-security.png", "ProjectShieldAlt", "ProjectCorporate", "ProjectShieldDescription", "ProjectShieldHeadline", "theme-sage", "business", "business"),
        new("04", "Ribeiro Consulting", "ribeiro.", "ribeiro.consulting", "images/project-consulting.png", "ProjectRibeiroAlt", "ProjectLanding", "ProjectRibeiroDescription", "ProjectRibeiroHeadline", "theme-peach", "landing", "landing")
    ];
}
