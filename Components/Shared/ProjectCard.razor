@inject IStringLocalizer<AppStrings> L
@inject ProjectBrief Brief

<article class="project-card" data-reveal style="--reveal-delay: @(RevealDelay)ms">
    <button class="project-visual @Theme" type="button" data-open-dialog="@DialogId" aria-label="@(L["ViewProject"] + ": " + Title)" aria-haspopup="dialog">
        <span class="project-visual-label">@Status <span>@Index / HTS</span></span>
        <span class="project-mini-browser">
            <span class="mini-browser-chrome"><span>● ● ●</span><span>@Domain</span></span>
            <span class="project-mini-site">
                <span class="mini-site-brand">@DisplayBrand <span>↗</span></span>
                <span class="mini-site-headline">@Headline</span>
                @if (HasImage)
                {
                    <img src="@Image" alt="@ImageAlt" width="1440" height="900" loading="lazy" />
                }
                else
                {
                    <span class="mini-site-mark" aria-hidden="true">@Monogram</span>
                }
                <span class="mini-site-footer">@L["DesignDevelopment"] <span>HTS /</span></span>
            </span>
        </span>
        <span class="project-view-badge">@L["ViewProject"] <UiIcon Name="diagonal" /></span>
    </button>
    <div class="project-caption"><div><p>@Subtitle</p><h3><button type="button" class="project-title-button" data-open-dialog="@DialogId" aria-haspopup="dialog">@Title</button></h3></div><a class="circle-button" href="@Url" target="_blank" rel="noopener" aria-label="@($"{L["VisitSite"]}: {Title} {L["OpensNewTab"]}")"><UiIcon Name="diagonal" /></a></div>
    <dialog id="@DialogId" class="project-dialog" aria-labelledby="@(DialogId + "-title")">
        <div class="dialog-top"><span class="eyebrow">@Status / @Index</span><button type="button" class="circle-button" data-close-dialog aria-label="@L["ClosePreview"]"><UiIcon Name="close" /></button></div>
        @if (HasImage)
        {
            <img src="@Image" alt="@ImageAlt" width="1440" height="900" loading="lazy" />
        }
        else
        {
            <div class="dialog-mark @Theme" aria-hidden="true"><span>@Monogram</span><span>@Domain</span></div>
        }
        <div class="dialog-copy">
            <p class="eyebrow">@Subtitle</p>
            <h3 id="@(DialogId + "-title")">@Title</h3>
            <p>@Description</p>
            <p class="project-note">@L["ProjectHostedNotice"]</p>
            <div class="dialog-actions">
                <a href="@Url" class="button button-orange" target="_blank" rel="noopener">@L["VisitSite"] <span class="visually-hidden">@L["OpensNewTab"]</span><UiIcon Name="diagonal" /></a>
                <a href="#quote" class="animated-link" data-close-dialog @onclick="() => Brief.SelectService(Service)">@L["WantSimilar"] <UiIcon Name="diagonal" /></a>
            </div>
        </div>
    </dialog>
</article>
@code {
    [Parameter, EditorRequired] public string Url { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string? Image { get; set; }
    [Parameter] public string ImageAlt { get; set; } = string.Empty;
    [Parameter] public string Monogram { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Status { get; set; } = string.Empty;
    [Parameter] public string Theme { get; set; } = string.Empty;
    [Parameter] public string Index { get; set; } = "01";
    [Parameter] public string DisplayBrand { get; set; } = string.Empty;
    [Parameter] public string Headline { get; set; } = string.Empty;
    [Parameter] public string Service { get; set; } = "business";
    [Parameter] public int RevealDelay { get; set; }
    private string DialogId => $"project-{Index}";
    private bool HasImage => !string.IsNullOrEmpty(Image);
    private string Domain => Uri.TryCreate(Url, UriKind.Absolute, out var uri) ? uri.Host : Url;
}
