@inject IStringLocalizer<AppStrings> L
@inject ProjectBrief Brief

<article class="project-card" data-reveal style="--reveal-delay: @(RevealDelay)ms">
    <button class="project-visual @Theme" type="button" data-open-dialog="@DialogId" aria-label="@(L["ViewConcept"] + ": " + Title)" aria-haspopup="dialog">
        <span class="project-visual-label">@L["ProjectConcept"] <span>@Index / HTS</span></span>
        <span class="project-mini-browser">
            <span class="mini-browser-chrome"><span>● ● ●</span><span>@Domain</span></span>
            <span class="project-mini-site">
                <span class="mini-site-brand">@DisplayBrand <span>↗</span></span>
                <span class="mini-site-headline">@Headline</span>
                <img src="@Image" alt="@ImageAlt" width="1024" height="1024" loading="lazy" />
                <span class="mini-site-footer">@L["DesignDevelopment"] <span>HTS /</span></span>
            </span>
        </span>
        <span class="project-view-badge">@L["ViewConcept"] <UiIcon Name="diagonal" /></span>
    </button>
    <div class="project-caption"><div><p>@Subtitle</p><h3><button type="button" class="project-title-button" data-open-dialog="@DialogId" aria-haspopup="dialog">@Title</button></h3></div><button class="circle-button" type="button" data-open-dialog="@DialogId" aria-label="@(L["ViewConcept"] + ": " + Title)" aria-haspopup="dialog"><UiIcon Name="diagonal" /></button></div>
    <dialog id="@DialogId" class="project-dialog" aria-labelledby="@(DialogId + "-title")">
        <div class="dialog-top"><span class="eyebrow">@L["ProjectConcept"] / @Index</span><button type="button" class="circle-button" data-close-dialog aria-label="@L["ClosePreview"]"><UiIcon Name="close" /></button></div>
        <img src="@Image" alt="@ImageAlt" width="1024" height="1024" loading="lazy" />
        <div class="dialog-copy"><p class="eyebrow">@Subtitle</p><h3 id="@(DialogId + "-title")">@Title</h3><p>@Description</p><p class="concept-note">@L["ConceptNotice"]</p><a href="#quote" class="button button-orange" data-close-dialog @onclick="() => Brief.SelectService(Service)">@L["WantSimilar"] <UiIcon Name="diagonal" /></a></div>
    </dialog>
</article>
@code {
    [Parameter, EditorRequired] public string Image { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ImageAlt { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Theme { get; set; } = string.Empty;
    [Parameter] public string Index { get; set; } = "01";
    [Parameter] public string Domain { get; set; } = string.Empty;
    [Parameter] public string DisplayBrand { get; set; } = string.Empty;
    [Parameter] public string Headline { get; set; } = string.Empty;
    [Parameter] public string Service { get; set; } = "business";
    [Parameter] public int RevealDelay { get; set; }
    private string DialogId => $"project-{Index}";
}
