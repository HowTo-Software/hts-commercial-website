@inject IStringLocalizer<AppStrings> L
@inject ProjectBrief Brief
@inject IJSRuntime JS

<article class="project-index-row @(Active ? "is-active" : "")" data-project-id="@Project.Index" @onpointerenter="OnPointerEnter">
    <div class="project-index-line">
        <button class="project-index-trigger" type="button" id="@($"project-trigger-{Project.Index}")"
                aria-pressed="@(Active ? "true" : "false")" aria-expanded="@(Active ? "true" : "false")"
                aria-controls="@($"project-mobile-{Project.Index} project-preview")" @onclick="Select" @onfocus="OnFocus">
            <span class="project-index-number">@Project.Index</span>
            <span class="project-index-name">@Project.Title</span>
            <span class="project-index-service">@L[Project.Type]</span>
        </button>
        <a class="project-site-link" href="@Project.Url" target="_blank" rel="noopener noreferrer"
           aria-label="@($"{L["VisitSite"]}: {Project.Title} {L["OpensNewTab"]}")"><UiIcon Name="diagonal" /></a>
    </div>
    <div id="@($"project-mobile-{Project.Index}")" class="project-mobile-slot" aria-hidden="@(Active ? "false" : "true")">
        <div class="project-mobile-inner">
            @if (Active)
            {
                <div class="project-mobile-content">
                    <div class="project-mobile-media"><ProjectPreview Project="Project" /></div>
                    <div class="project-mobile-copy">
                        <span class="project-preview-status">@L[Project.Status]</span>
                        <p>@L[Project.Description]</p>
                        <button type="button" class="animated-link" data-open-dialog="@Project.DialogId" aria-haspopup="dialog">
                            @L["ViewProject"] <UiIcon Name="diagonal" />
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
    <dialog id="@Project.DialogId" class="project-dialog" aria-labelledby="@(Project.DialogId + "-title")">
        <div class="dialog-top"><span class="eyebrow">@L[Project.Status] / @Project.Index</span><button type="button" class="circle-button" data-close-dialog aria-label="@L["ClosePreview"]"><UiIcon Name="close" /></button></div>
        <ProjectPreview Project="Project" />
        <div class="dialog-copy">
            <p class="eyebrow">@L[Project.Type]</p>
            <h3 id="@(Project.DialogId + "-title")">@Project.Title</h3>
            <p>@L[Project.Description]</p>
            <p class="project-note">@L["ProjectHostedNotice"]</p>
            <div class="dialog-actions">
                <a href="@Project.Url" class="button button-orange" target="_blank" rel="noopener noreferrer">@L["VisitSite"] <span class="visually-hidden">@L["OpensNewTab"]</span><UiIcon Name="diagonal" /></a>
                <a href="#quote" class="animated-link" data-close-dialog @onclick="() => Brief.SelectService(Project.Service)">@L["WantSimilar"] <UiIcon Name="diagonal" /></a>
            </div>
        </div>
    </dialog>
</article>
@code {
    [Parameter, EditorRequired] public PortfolioProject Project { get; set; } = null!;
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<string> Selected { get; set; }

    private Task Select() => Selected.InvokeAsync(Project.Index);

    private Task OnPointerEnter(PointerEventArgs args)
        => args.PointerType == "mouse" ? ActivateFrom("hover") : Task.CompletedTask;

    private Task OnFocus() => ActivateFrom("focus");

    private async Task ActivateFrom(string source)
    {
        if (Active) return;
        try
        {
            if (await JS.InvokeAsync<bool>("hts.projectIndexCanActivate", source, $"project-trigger-{Project.Index}"))
                await Select();
        }
        catch (JSDisconnectedException)
        {
            // A disconnected circuit no longer needs hover or focus updates.
        }
    }
}
